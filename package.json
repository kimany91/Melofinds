{
  "name": "melofinds",
  "version": "1.0.0",
  "description": "Moteur de recherche de prods YouTube : lit les descriptions, classe les licences (free for profit, up to, non-profit, payant), trouve des type beats depuis une description d'ambiance.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "demo": "MELOFINDS_DEMO=1 node server.js",
    "test": "node --test test/*.test.js",
    "build:artifact": "node scripts/build-artifact.mjs",
    "test:pc": "python3 -m unittest pc/test_melofinds_pc.py"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  }
}
